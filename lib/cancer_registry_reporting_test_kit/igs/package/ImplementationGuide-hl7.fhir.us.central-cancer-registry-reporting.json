ing a PlanDefintion for CCRR","exampleBoolean":true},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Bundle"}],"reference":{"reference":"Bundle/central-cancer-registry-reporting-specification-bundle-example"},"name":"CCRR Specification Bundle - Example","description":"An example showing a CCRR Specification Bundle or Knowledge Artifact","exampleBoolean":true},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Composition"}],"reference":{"reference":"Composition/ccrr-composition-example"},"name":"CCRR Composition - Example","description":"An example showing a CCRR Composition","exampleBoolean":true},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Bundle"}],"reference":{"reference":"Bundle/ccrr-encounter-based-content-bundle-example"},"name":"Encounter based CCRR Content Bundle - Example","description":"An example showing a Encounter based CCRR Content bundle","exampleBoolean":true},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Bundle"}],"reference":{"reference":"Bundle/reporting-bundle-example"},"name":"CCRR Reporting Bundle - Example","description":"An example showing a CCRR Reporting bundle","exampleBoolean":true},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Bundle"}],"reference":{"reference":"Bundle/ccrr-content-bundle-example"},"name":"Initial CCRR Content Bundle - Example","description":"An example showing an Initial CCRR Content bundle","exampleBoolean":true},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Bundle"}],"reference":{"reference":"Bundle/ccrr-non-encounter-based-content-bundle-example"},"name":"Non Encounter based CCRR Content Bundle - Example","description":"An example showing a non Encounter based CCRR Content bundle","exampleBoolean":true},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Observation"}],"reference":{"reference":"Observation/odh-usual-work"},"name":"ODH - Example","description":"An example showing a ODH Observation","exampleBoolean":true},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/ccrr-content-bundle"},"name":"Central Cancer Registry Reporting Content Bundle","description":"This profile is used to represent the Central Cancer Registry Report Content. The content bundle is represented using a bundle of type Document using the Composition resource."},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/ccrr-reporting-bundle"},"name":"Central Cancer Registry Reporting Bundle","description":"Bundle Resource profile for exchanging a cancer report with the Central Cancer Registry. This bundle contains the MessageHeader resource used for routing and the Content Bundle specifying the content."},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"CapabilityStatement"}],"reference":{"reference":"CapabilityStatement/central-cancer-registry-reporting-ehr"},"name":"Central Cancer Registry Reporting Data Source Capability Statement","description":"This profile defines the expected capabilities of the ''Data Source'' actor when conforming to the Central Cancer Registry Reporting Content IG.     This role is responsible for allowing creation, modification and deletion of Subscriptions and allows searching and retrieval of resources using US Core APIs."},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":